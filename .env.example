# Copy to .env.local for development. Every variable is NEXT_PUBLIC_* and is
# inlined into the bundle at BUILD time by src/config/env.js — changing one
# needs a rebuild, never just a redeploy.

# Base URL for canonical links, Open Graph URLs and sitemap.xml.
# Must match the domain actually being deployed to.
NEXT_PUBLIC_SITE_URL=https://battwheelz-demo.dqstore.in

# Serves the whole site noindex/nofollow and disallows it in robots.txt.
# Set to false for the real production site.
NEXT_PUBLIC_IS_DEMO_ENV=true

# Web3Forms access key — the enquiry form POSTs this to api.web3forms.com,
# which emails the enquiry to the address the key is registered to.
#
# PUBLIC BY DESIGN. The form submits from the browser (this is a static export,
# there is no server), so the key ships inside the JS bundle and anyone can read
# it. Web3Forms documents it as public-safe; it only permits sending mail to its
# own registered address. Never put a real secret in a NEXT_PUBLIC_ variable.
#
# REQUIRED AT BUILD TIME. A build without it produces a site whose form shows
# "not connected yet" instead of sending. Get the key from web3forms.com.
NEXT_PUBLIC_WEB3FORMS_KEY=
