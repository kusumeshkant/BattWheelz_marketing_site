# Production build configuration.
#
# Read by src/config/env.js — the only file in the project that touches
# process.env. Both values are inlined at BUILD time, so changing either one
# requires a rebuild, not just a redeploy.

# --- CURRENT STATE: CLIENT PREVIEW DEPLOYMENT -------------------------------
# Deployed to Cloudflare Pages (project: battwheelz-marketing) and served from
# the preview subdomain below. Neither value is the final production setting.

# Base URL for canonical links, Open Graph URLs and sitemap.xml.
# GOING LIVE: change to the client's real domain.
NEXT_PUBLIC_SITE_URL=https://battwheelz-demo.dqstore.in

# Serves the whole site noindex/nofollow and disallows it in robots.txt.
# GOING LIVE: set to false (or delete the line) and rebuild.
NEXT_PUBLIC_IS_DEMO_ENV=true
